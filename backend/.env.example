# ------------------ Application ------------------
ENVIRONMENT=local

# ------------------ File Upload ------------------
# Maximum uploaded file size in MB
MAX_FILE_SIZE_MB=50
INGESTION_BATCH_SIZE=100

# ------------------ Chunking ------------------
# Default chunk size in characters
DEFAULT_EMBEDDING_CHUNK_SIZE=256
DEFAULT_EMBEDDING_OVERLAP=50
DEFAULT_PROMPT_CHUNK_SIZE=1000
DEFAULT_PROMPT_OVERLAP=100
MAX_PROMPT_CHUNK_SIZE=3000
MIN_CHUNK_CHARS=50
DEDUP_SIMILARITY_THRESHOLD=0.97

# ------------------ Embedding ------------------
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SPARSE_EMBEDDING_MODEL_NAME=
RERANKER_MODEL_NAME=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# ------------------ Vector Store ------------------
VECTOR_STORE_PROVIDER=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=False
# QDRANT_API_KEY=change-me       # only needed for Qdrant Cloud / secured instances
QDRANT_COLLECTION=documents
DISTANCE_METRIC=Cosine

# ------------------ Retrieval ------------------
DEFAULT_TOP_K=5
MAX_TOP_K=20
MIN_SCORE=0.1
RETRIEVAL_FETCH_K=15
RERANK_MIN_SCORE=0.3

# ------------------ LLM ------------------
LLM_PROVIDER=groq
GROQ_API_KEY=........put_your_GROQ_API_KEY_here........
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
